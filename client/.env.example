# Audio engine that grades takes (pitch + timing). Without it the app runs in
# demo mode: grades are simulated, labelled as such, and never saved.
# Start the engine: cd audio-engine && source .venv/bin/activate && uvicorn main:app --port 8001
VITE_AUDIO_ENGINE_URL=http://127.0.0.1:8001
# Node backend — mentor chat, launch status, progress sync.
# Start: cd server && npm run dev
VITE_SERVER_URL=http://127.0.0.1:8000
# Features beyond the core learn → practice → feedback loop are hidden by default.
# Comma-separated: community, creator, proctored, liveLessons, compositions, teacher,
# expansionInstruments — or "all".
# VITE_FEATURES=
