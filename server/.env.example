PORT=8000
CORS_ORIGINS=http://localhost:5173
AUDIO_ENGINE_URL=http://127.0.0.1:8001
MUSICLUV_DATA_DIR=./data

# Identity. With SUPABASE_JWT_SECRET set, callers are identified only by a
# verified Supabase JWT (the x-user-id header is ignored). Required when
# NODE_ENV=production — the server refuses to start without it.
# SUPABASE_JWT_SECRET=
# Reject every non-public request without a verified identity:
# STRICT_AUTH=true
# Operator token for admin-only routes (proctor/reviewer actions, progress fixes):
# ADMIN_TOKEN=

# Features beyond the core loop are off: community, teacher, creator, proctored,
# liveLessons, compositions, styleMatch — or "all".
# FEATURES=

# LLM: set to enable real Claude mentor. Defaults to stub if unset.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6
# Hard cap on tokens per day across all users (bounds the bill):
# LLM_GLOBAL_TOKENS_PER_DAY=2000000
